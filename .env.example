# GitLab instance to read from
GITLAB_URL=https://invent.kde.org
# Optional: token for private projects (read_api scope is enough)
GITLAB_TOKEN=
# Optional: require this token from MCP clients (Authorization: Bearer ... or ?token=...)
MCP_AUTH_TOKEN=
# Optional: comma-separated project path prefixes that may be read
ALLOWED_PROJECTS=
# Optional: cap on a single tool result (default 200000)
MAX_RESPONSE_BYTES=
PORT=8787
